# Google OAuth 2.0 客户端凭据（复制本文件为 .env.local 后填入，.env.local 已被 .gitignore 排除，不会上传至代码仓库）
# 也可在构建打包时通过 -ldflags "-X more-account/internal/oauth.DefaultClientID=... -X more-account/internal/oauth.DefaultClientSecret=..." 注入，
# 或直接在客户端「设置」界面中配置（加密权限 0600 保存在本机 ~/.more-account/settings.json）。
MORE_ACCOUNT_OAUTH_CLIENT_ID=
MORE_ACCOUNT_OAUTH_CLIENT_SECRET=

# 默认检查更新的 GitHub 仓库（格式 owner/repo）
MORE_ACCOUNT_GITHUB_REPO=kong-hen/more-account
